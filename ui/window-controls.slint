import { Theme } from "theme.slint";

component CaptionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> close-button;
    callback clicked();
    width: 46px;
    background: touch.pressed ? (root.close-button ? #c42b1c : Theme.surface-control) : touch.has-hover ? (root.close-button ? #e81123 : Theme.hover) : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus-ring;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Image {
        source: root.icon; width: 12px; height: 12px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: root.close-button && (touch.has-hover || touch.pressed) ? white : Theme.text;
    }
    focus := FocusScope {
        key-pressed(e) => { if(e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } reject }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component WindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close();
    width: 138px; spacing: 0px;
    CaptionButton { label: "最小化"; icon: @image-url("icons/window-minimize.svg"); clicked => { root.minimize(); } }
    CaptionButton { label: root.maximized ? "还原" : "最大化"; icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg"); clicked => { root.toggle-maximize(); } }
    CaptionButton { label: "关闭"; icon: @image-url("icons/window-close.svg"); close-button: true; clicked => { root.close(); } }
}
