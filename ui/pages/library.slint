import { ScrollView, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../models.slint";
import { PageSurface, Label, Muted, Heading, Panel, AppButton, Badge, Progress, Divider, EmptyState } from "../components.slint";
import { MascotStage } from "../branding.slint";

export component ResourcesPage inherits PageSurface {
    background: transparent;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        Heading { text: "资源中心"; }
        HorizontalLayout {
            spacing: 12px;
            LineEdit { placeholder-text: "搜索资源名称或中文别名"; text: AppState.resource-query; edited(t) => { AppState.filter-resources(t, AppState.resource-category, AppState.compatible-only); } }
            Muted { text: "安装到"; horizontal-stretch: 0; }
            target := ComboBox { model: AppState.game-names; current-index: AppState.current-game-index; width: 240px; selected(_) => { AppState.choose-game-at(self.current-index); } }
        }
        HorizontalLayout {
            spacing: 6px;
            ComboBox { width: 180px; height: 34px; model: ["模组", "整合包", "资源包", "光影", "世界"]; current-index: AppState.resource-category; selected(_) => { AppState.filter-resources(AppState.resource-query, self.current-index, AppState.compatible-only); } }
            Rectangle { horizontal-stretch: 1; }
            CheckBox { text: "仅看兼容"; checked: AppState.compatible-only; toggled => { AppState.filter-resources(AppState.resource-query, AppState.resource-category, self.checked); } }
        }
        HorizontalLayout { Muted { text: AppState.resources.length + " 项资源  ·  演示目录"; } Muted { text: "目标：" + AppState.current-game.name + " · #" + AppState.current-game.id + " · " + AppState.current-game.version + " / " + AppState.current-game.loader; horizontal-alignment: right; } }
        Panel {
        border-radius: 8px;
        ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 0px;
                for item in AppState.resources: Rectangle {
                    height: 92px;
                    HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Rectangle { width: 36px; height: 36px; border-radius: 6px; background: item.tint; Image { x: 8px; y: 8px; width: 20px; height: 20px; source: @image-url("../icons/resources.svg"); colorize: white; } }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout { Label { text: item.name; font-size: 14px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Badge { text: item.source; } }
                            Label { text: item.description; font-size: 13px; }
                            Muted { text: item.detail; }
                        }
                        VerticalLayout {
                            width: 112px; spacing: 8px; alignment: center;
                            if(!item.compatible): Badge { text: "版本不兼容"; warning: true; }
                            AppButton { text: item.installed ? "已安装" : "查看并安装"; enabled: !item.installed && item.compatible; clicked => { AppState.install-resource(item.id); } }
                        }
                    }
                    Divider { y: parent.height - 1px; }
                }
                if(AppState.resources.length == 0): EmptyState { title: "没有匹配的资源"; description: "试试其他关键词，或关闭「仅看兼容」查看全部演示条目。"; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        }
    }
}

export component DownloadsPage inherits PageSurface {
    background: transparent;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        HorizontalLayout { Heading { text: "下载任务"; } AppButton { text: "清除已完成"; enabled: AppState.downloads.length > 0; clicked => { AppState.clear-downloads(); } } }
        Muted { text: "当前仅展示模拟资源任务，尚未接入真实下载。"; wrap: word-wrap; }
        ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 6px;
                for item in AppState.downloads: Panel {
                    height: 104px; border-radius: 8px;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        HorizontalLayout {
                            VerticalLayout { spacing: 4px; Label { text: item.name; font-weight: 600; font-size: 14px; } Muted { text: item.detail; } }
                            Badge { text: item.state; positive: item.done; }
                            AppButton { text: item.done ? "查看游戏" : item.paused ? "继续" : "暂停"; clicked => { if(item.done) { AppState.view-download(item.id); } else { AppState.toggle-download(item.id); } } }
                            if(!item.done): AppButton { text: "取消"; quiet: true; clicked => { AppState.cancel-download(item.id); } }
                        }
                        Progress { value: item.progress; }
                        Muted { text: item.progress + "%"; horizontal-alignment: right; }
                    }
                }
                if(AppState.downloads.length == 0): Panel {
                    height: 184px; border-radius: 8px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        EmptyState { title: "暂无模拟任务"; description: "在资源中心操作演示条目后，可在这里查看模拟进度。"; }
                        HorizontalLayout { Rectangle {} AppButton { text: "打开资源中心"; clicked => { AppState.navigate(3); } } Rectangle {} }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

export component AccountsPage inherits PageSurface {
    background: transparent;
    ScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            padding: 20px; spacing: 12px;
            HorizontalLayout { Heading { text: "账号与装扮"; } AppButton { text: "＋ 添加账号"; primary: true; clicked => { AppState.open-modal("account", 0); } } }
            Muted { text: "切换游戏身份；皮肤和披风统一在这里管理。"; }
            for account in AppState.accounts: Panel {
                height: 76px; border-radius: 8px;
                HorizontalLayout {
                    padding: 12px; spacing: 12px;
                    Rectangle { width: 36px; height: 36px; border-radius: 6px; background: Theme.accent-soft; Image { source: @image-url("../icons/account.svg"); width: 20px; height: 20px; x: 8px; y: 8px; colorize: Theme.accent; } }
                    VerticalLayout { spacing: 4px; Label { text: account.name; font-size: 14px; font-weight: 600; } Muted { text: account.kind; } }
                    if(account.active): Badge { text: "当前账号"; positive: true; }
                    AppButton { text: "使用此账号"; enabled: !account.active; clicked => { AppState.select-account(account.id); } }
                }
            }
            Panel {
                height: 304px; border-radius: 8px;
                HorizontalLayout {
                    padding: 16px; spacing: 20px;
                    Rectangle { width: 230px; border-radius: Theme.pixel-glass ? 0px : 12px; background: Theme.canvas; MascotStage { x: 4px; y: 0px; width: parent.width - 8px; height: parent.height - 4px; controls: true; } }
                    VerticalLayout {
                        padding-top: 22px; padding-bottom: 22px; spacing: 14px;
                        HorizontalLayout { Badge { text: "社团形象"; } Rectangle { horizontal-stretch: 1; } }
                        Label { text: "孪枭"; font-size: 28px; font-weight: 700; }
                        Muted { text: "美术部提供  /  64 × 64 双层经典模型"; }
                        Label { text: "模型预览"; font-size: 14px; }
                        Muted { text: "使用下方方向按钮旋转，点击复位恢复初始视角。"; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Muted { text: "仅本地预览，尚未应用到游戏账号。"; color: Theme.sky; wrap: word-wrap; }
                        HorizontalLayout { AppButton { text: "皮肤与披风说明"; clicked => { AppState.open-modal("skin", 0); } } Rectangle { horizontal-stretch: 1; } }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
