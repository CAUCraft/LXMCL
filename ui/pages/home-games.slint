import { ScrollView, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../models.slint";
import { PageSurface, Label, Muted, Heading, Panel, AppButton, NativeButton, Divider, EmptyState } from "../components.slint";

component InstanceRow inherits Rectangle {
    in property <string> name;
    in property <string> subtitle;
    in property <bool> selected;
    in property <bool> request-focus;
    in property <int> focus-generation;
    callback select();
    callback manage();
    callback folder();
    callback rename();
    callback move(int);
    changed request-focus => { if(root.request-focus) { row-focus.focus(); } }
    changed focus-generation => { if(root.request-focus) { row-focus.focus(); } }
    height: 64px;
    background: root.selected ? Theme.accent-soft : hover.has-hover ? Theme.hover : transparent;
    border-radius: 6px;
    border-width: row-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus-ring;
    forward-focus: row-focus;
    accessible-role: button;
    accessible-label: root.name + "，" + root.subtitle + (root.selected ? "，当前启动实例" : "，选择启动实例");
    accessible-action-default => { row-focus.focus(); root.select(); }
    row-focus := FocusScope {
        key-pressed(e) => {
            if(e.text == Key.DownArrow) { root.move(1); return accept; }
            if(e.text == Key.UpArrow) { root.move(-1); return accept; }
            if(e.text == Key.Return) { root.manage(); return accept; }
            if(e.text == Key.F2) { if(!AppState.instance-saving) { root.rename(); } return accept; }
            if(e.text == " ") { root.select(); return accept; }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 12px;
                Label { width: 18px; text: root.selected ? "●" : "○"; color: Theme.accent; }
                Rectangle {
                    width: 28px;
                    Image { source: @image-url("../icons/cube.svg"); width: 28px; height: 28px; y: (parent.height - self.height) / 2; colorize: Theme.accent; }
                }
                VerticalLayout { padding-top: 12px; padding-bottom: 12px; spacing: 4px; Label { text: root.name; font-weight: 600; } Muted { text: root.subtitle; } }
            }
            hover := TouchArea {
                mouse-cursor: pointer;
                clicked => { row-focus.focus(); root.select(); }
                double-clicked => { root.manage(); }
            }
        }
        Rectangle { width: 34px; NativeButton { width: 34px; height: 32px; y: (parent.height - self.height) / 2; quiet: true; with-icon: true; icon: @image-url("../icons/sliders.svg"); description: "管理 " + root.name; show-tooltip: true; clicked => { root.manage(); } } }
        Rectangle { width: 34px; NativeButton { width: 34px; height: 32px; y: (parent.height - self.height) / 2; quiet: true; with-icon: true; icon: @image-url("../icons/folder.svg"); description: "打开 " + root.name + " 的文件夹"; show-tooltip: true; clicked => { root.folder(); } } }
        Rectangle { width: 34px; NativeButton { width: 34px; height: 32px; y: (parent.height - self.height) / 2; quiet: true; with-icon: true; icon: @image-url("../icons/edit.svg"); description: "重命名 " + root.name + " · F2"; show-tooltip: true; enabled: !AppState.instance-saving; clicked => { root.rename(); } } }
    }
}

export component GamesPage inherits PageSurface {
    background: transparent;
    property <int> focused-index: -1;
    property <int> focused-id: -1;
    property <int> focus-generation: 0;
    property <bool> detail-open: AppState.instance-detail-open;
    property <bool> rename-open: AppState.modal == "rename";
    property <bool> restore-pending: false;
    changed detail-open => {
        if(!root.detail-open) { root.focused-id = AppState.inspected-game.id; root.restore-pending = true; }
    }
    changed rename-open => { if(!root.rename-open && !AppState.instance-detail-open) { root.restore-pending = true; } }
    // Run after the controller restores the window scope. An excluded target
    // leaves focus in search; a matching visible row takes it on this generation.
    Timer {
        interval: 1ms;
        running: root.restore-pending;
        triggered => { root.restore-pending = false; search.focus(); root.focus-generation += 1; }
    }
    function move-selection(delta: int) {
        if(AppState.games.length > 0) {
            root.focused-index = max(0, min(AppState.games.length - 1, root.focused-index + delta));
            root.focused-id = AppState.games[root.focused-index].id;
            AppState.choose-game(root.focused-id);
            if(root.focused-index * 64px < -AppState.library-scroll-y) { AppState.library-scroll-y = -root.focused-index * 64px; }
            if((root.focused-index + 1) * 64px > -AppState.library-scroll-y + library.height) { AppState.library-scroll-y = library.height - (root.focused-index + 1) * 64px; }
        }
    }
    // Keep this list alive under the detail surface: search, viewport and focus survive back.
    Rectangle {
    visible: !AppState.instance-detail-open;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        HorizontalLayout {
            Heading { text: "实例"; font-size: 17px; }
            search := LineEdit { width: 236px; height: 34px; placeholder-text: "搜索实例"; text: AppState.game-filter; edited(t) => { root.focused-index = -1; root.focused-id = -1; AppState.filter-games(t); } }
            AppButton { text: "创建实例"; primary: true; clicked => { AppState.open-modal("create", 0); } }
        }
        Panel {
            border-radius: 8px;
            library := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-y <=> AppState.library-scroll-y;
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for game[i] in AppState.games: InstanceRow {
                        name: game.name; subtitle: game.version + " · " + game.loader;
                        selected: AppState.current-game.id == game.id;
                        request-focus: !AppState.instance-detail-open && root.focused-id == game.id;
                        focus-generation: root.focus-generation;
                        select => { root.focused-index = i; root.focused-id = game.id; AppState.choose-game(game.id); }
                        manage => { root.focused-index = i; root.focused-id = game.id; AppState.open-instance(game.id); }
                        folder => { AppState.open-instance-folder(game.id); }
                        rename => { root.focused-index = i; root.focused-id = game.id; AppState.open-modal("rename", game.id); }
                        move(delta) => { root.focused-index = i; root.move-selection(delta); }
                    }
                    if(AppState.games.length == 0): EmptyState { title: "没有找到实例"; description: "创建实例只保存配置，不会安装游戏文件。"; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
    }
    if(AppState.instance-detail-open): PageSurface {
        background: Theme.canvas;
        ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    VerticalLayout { spacing: 5px; Heading { text: AppState.inspected-game.name; } Muted { text: AppState.inspected-game.version + " · " + AppState.inspected-game.loader; } }
                    AppButton { text: "启动演示"; primary: true; enabled: !AppState.launching; clicked => { AppState.launch-instance(AppState.inspected-game.id); } }
                    AppButton { text: "打开文件夹"; clicked => { AppState.open-instance-folder(AppState.inspected-game.id); } }
                }
                if(AppState.instance-section == 0): Panel { border-radius: 8px;
                    min-height: 270px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        Label { text: "实例属性"; font-size: 14px; font-weight: 600; }
                        HorizontalLayout { height: 36px; Muted { text: "名称"; width: 120px; } Label { text: AppState.inspected-game.name; } }
                        Divider {}
                        HorizontalLayout { height: 36px; Muted { text: "游戏版本"; width: 120px; } Label { text: AppState.inspected-game.version; } }
                        Divider {}
                        HorizontalLayout { height: 36px; Muted { text: "加载器"; width: 120px; } Label { text: AppState.inspected-game.loader; } }
                        Divider {}
                        HorizontalLayout { min-height: 40px; Muted { text: "游戏目录"; width: 120px; } Label { text: AppState.inspected-directory; wrap: word-wrap; } }
                        Muted { text: "实例配置与本机 Java 检测可用；安装、认证、下载和启动仍为演示。"; wrap: word-wrap; }
                        HorizontalLayout {
                            AppButton { text: "重命名"; enabled: !AppState.instance-saving; clicked => { AppState.open-modal("rename", AppState.inspected-game.id); } }
                            AppButton { text: "整合包"; clicked => { AppState.navigate(3); AppState.filter-resources(AppState.resource-query, 1, AppState.compatible-only); } }
                            Rectangle { horizontal-stretch: 1; }
                            AppButton { text: "删除实例（演示）"; quiet: true; clicked => { AppState.open-modal("delete", AppState.inspected-game.id); } }
                        }
                    }
                }
                if(AppState.instance-section >= 1 && AppState.instance-section <= 4): VerticalLayout {
                    spacing: 16px;
                    HorizontalLayout {
                        Muted { text: AppState.mods.length + " 项内容 · 演示资源"; }
                        AppButton { text: "获取更多"; clicked => { AppState.navigate(3); } }
                        AppButton { text: "导入资源"; clicked => { AppState.open-modal("import", 0); } }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 16px; spacing: 0px;
                            for item in AppState.mods: Rectangle {
                                height: item.updatable ? 76px : 94px;
                                VerticalLayout {
                                    padding-top: 12px; padding-bottom: 12px; spacing: 6px;
                                    HorizontalLayout {
                                        if(AppState.game-tab != 4): CheckBox { checked: item.enabled; text: item.name; toggled => { AppState.toggle-mod(item.id); } }
                                        if(AppState.game-tab == 4): Label { text: item.name; font-weight: 600; }
                                        Rectangle { horizontal-stretch: 1; }
                                        if(item.updatable): AppButton { text: "检查更新"; quiet: true; clicked => { AppState.update-mod(item.id); } }
                                    }
                                    Muted { text: item.detail + " · " + item.source; }
                                    if(!item.updatable): Muted { text: "用户自行导入 · 不支持在线更新"; }
                                }
                                Divider { y: parent.height - 1px; }
                            }
                            if(AppState.mods.length == 0): EmptyState { title: "这里还没有内容"; description: "从资源中心获取，或导入本地资源。"; }
                        }
                    }
                }
                if(AppState.instance-section == 5): Panel { border-radius: 8px;
                    min-height: 200px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        Label { text: "继承全局默认配置"; font-size: 16px; font-weight: 600; }
                        HorizontalLayout { Label { text: "内存分配"; } Muted { text: AppState.auto-memory ? "自动" : AppState.memory + " GB"; horizontal-alignment: right; } }
                        Divider {}
                        HorizontalLayout { Label { text: "游戏窗口"; } Muted { text: AppState.fullscreen ? "全屏" : "1280 × 720"; horizontal-alignment: right; } }
                        Muted { text: "独立实例覆盖尚未实现。"; }
                        AppButton { text: "修改全局默认配置"; clicked => { AppState.settings-category = 1; AppState.navigate(6); } }
                    }
                }
                if(AppState.instance-section == 6): Panel { border-radius: 8px;
                    min-height: 180px;
                    VerticalLayout { padding: 16px; spacing: 12px; Label { text: "实例日志"; font-size: 16px; font-weight: 600; } Muted { text: "尚未启动真实游戏，当前没有可展示的实例运行日志。"; wrap: word-wrap; } AppButton { text: "启动器诊断日志"; clicked => { AppState.diagnose(2); AppState.navigate(7); } } }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

export component ServersPage inherits PageSurface {
    VerticalLayout {
        padding: 20px; spacing: 12px;
        Heading { text: AppState.server-section == 0 ? "服务器" : "联机房间"; font-size: 17px; }
        Divider {}
        Label { text: "联机服务未启用"; font-weight: 600; }
        Muted { text: "当前基础版本不提供联机或社团服务，后续由插件提供。"; wrap: word-wrap; }
        HorizontalLayout {
            AppButton { text: "管理扩展"; clicked => { AppState.settings-category = 6; AppState.navigate(6); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
