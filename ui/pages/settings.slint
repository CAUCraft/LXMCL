import { ScrollView, LineEdit, ComboBox, CheckBox, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../models.slint";
import { PageSurface, Label, Muted, Heading, Panel, AppButton, NativeButton, Badge, Divider, SettingRow } from "../components.slint";
import { WallpaperPicker } from "../wallpaper-picker.slint";
import { Guidance } from "../guidance-models.slint";

export component SettingsPage inherits PageSurface {
    property <int> category: AppState.settings-category;
    VerticalLayout {
        padding-top: 16px; padding-bottom: 0px;
        padding-left: max(16px, (root.width - 800px) / 2); padding-right: max(16px, (root.width - 800px) / 2); spacing: 12px;
        HorizontalLayout {
            Heading { text: ["常规", "游戏", "Java", "网络", "外观", "账号", "扩展", "关于"][AppState.settings-category]; }

        }
        HorizontalLayout {
            spacing: 12px;
            ScrollView {
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    alignment: start; spacing: 12px; padding-right: 8px;
                    if(root.category == 1): VerticalLayout {
                        spacing: 12px;
                        Panel { vertical-stretch: 0;
                            min-height: 210px;
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                HorizontalLayout { Label { vertical-stretch: 0; text: "游戏默认配置"; font-size: 14px; font-weight: 600; } Badge { text: "全局默认"; } }
                                SettingRow { label: "内存分配"; CheckBox { text: "自动分配"; width: 120px; checked <=> AppState.auto-memory; } SpinBox { width: 100px; value <=> AppState.memory; minimum: 1; maximum: 32; enabled: !AppState.auto-memory; } Muted { vertical-stretch: 0; text: "GB"; width: 24px; } }
                                Divider {}
                                SettingRow { label: "游戏窗口"; CheckBox { text: "全屏启动"; width: 126px; checked <=> AppState.fullscreen; } }
                                Muted { vertical-stretch: 0; text: "实例配置入口：版本 → 游戏设置。逐项覆盖尚未实现。"; wrap: word-wrap; }
                            }
                        }
                        Panel { vertical-stretch: 0;
                            min-height: 132px;
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                Label { vertical-stretch: 0; text: "游戏存储"; font-size: 14px; font-weight: 600; }
                                LineEdit { text <=> AppState.folder; placeholder-text: "例如 D:\\Games\\LXMCL"; accessible-label: "游戏存放目录"; }
                                Muted { vertical-stretch: 0; text: "保存新实例的默认位置；不会创建或移动游戏文件。"; wrap: word-wrap; }
                            }
                        }
                    }
                    if(root.category == 2): Panel { vertical-stretch: 0;
                        min-height: 280px;
                        VerticalLayout {
                            alignment: start; padding: 16px; spacing: 12px;
                            HorizontalLayout {
                                Label { vertical-stretch: 0; text: "Java 运行环境"; font-size: 14px; font-weight: 600; }
                                Rectangle { horizontal-stretch: 1; }
                                AppButton { text: AppState.java-detecting ? "检测中…" : "检测 Java"; enabled: !AppState.java-detecting; clicked => { AppState.detect-java(); } }
                            }
                            Muted { vertical-stretch: 0; text: AppState.java-status; wrap: word-wrap; }
                            Label { vertical-stretch: 0; text: "当前：" + (AppState.java-selected == "" ? "自动选择（尚未指定）" : AppState.java-selected); wrap: word-wrap; }
                            for item in AppState.java-candidates: Rectangle {
                                min-height: 78px; background: Theme.canvas; border-radius: 8px;
                                HorizontalLayout {
                                    padding: 12px; spacing: 12px;
                                    VerticalLayout { spacing: 4px; Label { vertical-stretch: 0; text: item.title; font-weight: 600; } Muted { vertical-stretch: 0; text: item.path; } Muted { vertical-stretch: 0; text: item.detail; } }
                                    AppButton { text: "使用"; enabled: !AppState.java-detecting; clicked => { AppState.use-java(item.path); } }
                                }
                            }
                            if(AppState.java-notes != ""): Muted { vertical-stretch: 0; text: AppState.java-notes; wrap: word-wrap; color: Theme.amber; }
                            Divider {}
                            Label { vertical-stretch: 0; text: "手动指定 Java"; font-weight: 600; }
                            HorizontalLayout {
                                LineEdit { text <=> AppState.java-input; placeholder-text: "java.exe 的完整路径"; accessible-label: "Java 可执行文件路径"; enabled: !AppState.java-detecting; }
                                AppButton { text: "验证并保存"; enabled: !AppState.java-detecting; clicked => { AppState.verify-java(); } }
                            }
                            Muted { vertical-stretch: 0; text: "Java 选择验证后立即保存，作为所有实例的默认运行环境；会真实启动 Java 检测版本，不修改系统环境变量。"; wrap: word-wrap; }
                            HorizontalLayout {
                                AppButton { text: "使用自动选择"; quiet: true; enabled: !AppState.java-detecting; clicked => { AppState.auto-java(); } }
                                Rectangle { horizontal-stretch: 1; }
                                AppButton { text: "环境准备教程"; quiet: true; clicked => { Guidance.open-article("java"); } }
                            }
                        }
                    }
                    if(root.category == 3): Panel { vertical-stretch: 0;
                        min-height: 208px;
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Label { vertical-stretch: 0; text: "网络与下载"; font-size: 14px; font-weight: 600; }
                            SettingRow { label: "代理方式"; ComboBox { model: ["跟随系统代理", "不使用代理", "手动配置（待接入）"]; current-index <=> AppState.proxy-mode; width: 250px; } }
                            SettingRow { label: "下载源"; ComboBox { model: ["自动选择", "官方源", "BMCLAPI"]; current-index <=> AppState.source-mode; width: 250px; } }
                            Muted { vertical-stretch: 0; text: "当前保存偏好；游戏下载与网络诊断仍为演示。"; wrap: word-wrap; }
                        }
                    }
                    if(root.category == 4): VerticalLayout {
                        spacing: 12px;
                        Panel { vertical-stretch: 0;
                            min-height: 208px;
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                Label { vertical-stretch: 0; text: "外观"; font-size: 14px; font-weight: 600; }
                                SettingRow { label: "深色模式"; CheckBox { text: "启用"; width: 92px; checked: Theme.dark; toggled => { AppState.set-dark(self.checked); } } }
                                SettingRow { label: "减少界面动态效果"; CheckBox { text: "启用"; width: 92px; checked <=> Theme.reduce-motion; } }
                                Divider {}
                                Muted { vertical-stretch: 0; text: "静态背景为默认；动态壁纸可按需启用。"; wrap: word-wrap; }
                            }
                        }
                        WallpaperPicker {}
                    }
                    if(AppState.settings-category == 0): Panel { vertical-stretch: 0;
                        min-height: 184px;
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Label { vertical-stretch: 0; text: "启动器"; font-size: 14px; font-weight: 600; }
                            SettingRow { label: "首次游玩"; AppButton { text: "打开游玩向导"; clicked => { Guidance.open-guide(); } } }
                            Divider {}
                            SettingRow { label: "使用帮助"; AppButton { text: "打开离线教程"; clicked => { AppState.navigate(8); } } }
                            Muted { vertical-stretch: 0; text: "实例记录、应用偏好与 Java 选择保存在本机。"; wrap: word-wrap; }
                        }
                    }
                    if(AppState.settings-category == 6): VerticalLayout {
                        spacing: 12px;
                        Muted { vertical-stretch: 0; text: "当前组装已加载的插件及其页面动作。"; }
                        Panel { vertical-stretch: 0;
                            VerticalLayout {
                                padding: 16px; spacing: 0px;
                                for item in AppState.extensions: Rectangle {
                                    min-height: 94px;
                                    HorizontalLayout {
                                        padding-top: 14px; padding-bottom: 14px; spacing: 12px;
                                        VerticalLayout {
                                            spacing: 5px;
                                            Label { vertical-stretch: 0; text: item.title; font-weight: 600; }
                                            Muted { vertical-stretch: 0; text: item.detail; wrap: word-wrap; }
                                            Muted { vertical-stretch: 0; text: item.status + (item.placement == "" ? "" : " · " + item.placement); wrap: word-wrap; }
                                        }
                                        if(item.action-label != ""): AppButton { text: item.action-label; enabled: !AppState.extension-busy; clicked => { AppState.extension-action(item.id); } }
                                    }
                                    Divider { y: parent.height - 1px; }
                                }
                                if(AppState.extensions.length == 0): Muted { vertical-stretch: 0; text: "当前没有贡献工作区动作的插件。"; }
                            }
                        }
                        if(AppState.extension-status != ""): Muted { vertical-stretch: 0; text: AppState.extension-status; wrap: word-wrap; }
                    }
                    if(AppState.settings-category == 7): Panel { vertical-stretch: 0;
                        min-height: 180px;
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Label { vertical-stretch: 0; text: "LXMCL"; font-size: 17px; font-weight: 600; }
                            Muted { vertical-stretch: 0; text: "面向 CAUCRAFT 的 Rust + Slint 原生 Minecraft 启动器"; wrap: word-wrap; }
                            Divider {}
                            Muted { vertical-stretch: 0; text: "实例配置、本机 Java 检测与设置持久化可用。认证、安装、下载、启动与联机仍为演示。"; wrap: word-wrap; }
                        }
                    }
                    Rectangle { min-height: 2px; vertical-stretch: 1; }
                }
            }
        }
        Rectangle {
            height: 54px; background: Theme.canvas;
            Divider { y: 0px; }
            HorizontalLayout {
                padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                Muted { vertical-stretch: 0; text: root.category == 2 ? "Java 选择验证后立即保存。" : "界面及游戏偏好在点击应用后保存到本机。"; horizontal-stretch: 1; }
                AppButton { text: "应用设置"; primary: true; enabled: !AppState.java-detecting && !AppState.instance-saving; clicked => { AppState.save-settings(); } }
            }
        }
    }
}

export component DiagnosticsPage inherits PageSurface {
    background: transparent;
    ScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            padding: 28px; spacing: 20px;
            Heading { text: "诊断与工具"; }
            Muted { text: "先查看问题，再选择修复方式。以下检查目前使用演示结果。"; wrap: word-wrap; }
            HorizontalLayout { spacing: 12px; AppButton { text: "检查游戏环境"; enabled: !AppState.diagnosing; clicked => { Guidance.start-check(false); } } AppButton { text: "测试网络连接"; enabled: !AppState.diagnosing; clicked => { AppState.diagnose(1); } } AppButton { text: "查看运行日志"; clicked => { AppState.diagnose(2); } } Rectangle {} }
            Panel {
                min-height: 300px;
                VerticalLayout { padding: 24px; spacing: 12px; Label { text: "检查结果"; font-size: 18px; font-weight: 600; } Divider {} Label { text: AppState.diagnostic-text; wrap: word-wrap; vertical-alignment: top; } Rectangle { vertical-stretch: 1; } }
            }
            Panel { height: 110px; HorizontalLayout { padding: 16px; spacing: 20px; VerticalLayout { spacing: 8px; Label { text: "找不到解决方法？"; font-weight: 600; } Muted { text: "从帮助中心按任务查找，保留当前游戏和问题上下文。"; } } AppButton { text: "打开帮助中心"; clicked => { AppState.navigate(8); } } } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
