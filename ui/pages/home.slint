import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../models.slint";
import { Label, Muted, GlassPanel, NativeButton } from "../components.slint";

export component HomePage inherits Rectangle {
    in property <bool> window-visible: true;
    property <bool> selector-open: false;
    property <int> option-index: 0;
    property <bool> overlay-blocked: AppState.modal != "" || AppState.search-open;
    changed overlay-blocked => { if(root.overlay-blocked) { root.selector-open = false; } }
    function close-selector() { root.selector-open = false; version-button.focus-button(); }
    function open-selector() {
        if(AppState.installed-instances.length > 0) {
            root.option-index = AppState.current-game-index;
            root.selector-open = true;
            selector-focus.focus();
        } else { AppState.navigate(1); }
    }
    Image { source: @image-url("../assets/daylight-river.png"); width: parent.width; height: parent.height; image-fit: cover; }
    if(AppState.wallpaper-enabled && AppState.wallpaper-ready): Image {
        source: AppState.wallpaper-frame; width: parent.width; height: parent.height; image-fit: cover;
    }
    card := GlassPanel {
        width: min(374px, parent.width - 48px); height: 238px;
        x: parent.width - self.width - 26px; y: parent.height - self.height - 26px;
        VerticalLayout {
            padding: 26px; spacing: 18px;
            version-button := NativeButton {
                height: 46px; text-size: 16px;
                text: AppState.current-game.id >= 0 ? AppState.current-game.version + " · " + AppState.current-game.loader : "尚无实例";
                description: "选择游戏版本";
                with-icon: true; icon: @image-url("../icons/cube.svg");
                trailing-arrow: true; left-aligned: true;
                clicked => { if(root.selector-open) { root.close-selector(); } else { root.open-selector(); } }
            }
            NativeButton {
                height: 58px; launch: true; with-icon: true; icon: @image-url("../icons/play.svg"); icon-size: 25px; text-size: 19px;
                text: AppState.current-game.id < 0 ? "创建实例" : AppState.launching ? "正在检查…" : "启动游戏";
                description: AppState.current-game.id < 0 ? "创建实例配置，不安装游戏文件" : "检查当前实例并进入启动演示";
                enabled: !AppState.launching;
                clicked => { if(AppState.current-game.id < 0) { AppState.open-modal("create", 0); } else { AppState.launch-game(); } }
            }
            HorizontalLayout {
                height: 42px; spacing: 22px;
                NativeButton { quiet: true; with-icon: true; icon: @image-url("../icons/folder.svg"); icon-size: 24px; description: "打开游戏文件夹"; show-tooltip: true; enabled: AppState.current-game.id >= 0; clicked => { AppState.open-game-folder(); } }
                Rectangle { width: 1px; height: 26px; background: Theme.line; }
                NativeButton { quiet: true; with-icon: true; icon: @image-url("../icons/sliders.svg"); icon-size: 24px; description: "当前游戏设置"; show-tooltip: true; enabled: AppState.current-game.id >= 0; clicked => { AppState.open-game-settings(); } }
            }
        }
    }
    if(root.selector-open): TouchArea { clicked => { root.close-selector(); } }
    GlassPanel {
        opacity: root.selector-open ? 1 : 0;
        visible: root.selector-open || self.opacity > 0;
        animate opacity { duration: Theme.animations-ready && !Theme.reduce-motion ? 160ms : 0ms; }
        x: card.x; width: card.width;
        height: min(294px, min(AppState.installed-instances.length * 66px + 16px, card.y - 20px));
        y: card.y - self.height - 10px;
        border-radius: 18px;
        TouchArea {}
        selector-focus := FocusScope {
            enabled: root.selector-open;
            key-pressed(e) => {
                if(e.text == Key.Escape) { root.close-selector(); return accept; }
                if(e.text == Key.DownArrow) { root.option-index = min(AppState.installed-instances.length - 1, root.option-index + 1); return accept; }
                if(e.text == Key.UpArrow) { root.option-index = max(0, root.option-index - 1); return accept; }
                if(e.text == Key.Return || e.text == " ") { AppState.choose-game(AppState.installed-instances[root.option-index].id); root.close-selector(); return accept; }
                reject
            }
            VerticalLayout {
                padding: 8px; spacing: 4px;
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-y: -max(0px, root.option-index * 66px - self.height + 66px);
                    VerticalLayout {
                        spacing: 4px;
                        for item[i] in AppState.installed-instances: Rectangle {
                            height: 62px;
                            NativeButton {
                                enabled: root.selector-open;
                                selected: root.option-index == i; quiet: true;
                                description: item.selector-label + "，" + item.name;
                                clicked => { AppState.choose-game(item.id); root.close-selector(); }
                            }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; spacing: 12px;
                                Image { source: @image-url("../icons/cube.svg"); width: 20px; height: 20px; colorize: Theme.text; }
                                VerticalLayout {
                                    padding-top: 10px; padding-bottom: 10px; spacing: 4px;
                                    Label { text: item.version + " · " + item.loader; font-weight: 600; }
                                    Muted { text: item.name + " · #" + item.id; }
                                }
                                Label { text: item.id == AppState.current-game.id ? "✓" : ""; width: 20px; color: Theme.text; }
                            }
                        }
                    }
                }
            }
        }
    }
}
