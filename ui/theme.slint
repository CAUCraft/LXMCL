export global Theme {
    out property <length> control-height: 32px;
    out property <length> control-radius: 6px;
    out property <length> group-radius: 8px;
    out property <color> context-surface: tone(#f4f7fc, #202c39);
    in-out property <bool> dark: false;
    // Retained for preferences and the legacy secondary-page material.
    in-out property <bool> pixel-glass: false;
    in-out property <bool> animations-ready: false;
    in-out property <bool> reduce-motion: false;
    in-out property <float> darkness: 0;
    public pure function tone(day: color, night: color) -> color { night.mix(day, root.darkness) }
    out property <color> window-surface: tone(#e7f0fc, #202b3a);
    out property <color> surface-glass: tone(#f1f4f0ed, #202a35f2);
    out property <color> surface-control: tone(#ffffffe0, #34404de8);
    out property <color> border-soft: tone(#ffffffb8, #ffffff26);
    out property <color> focus-ring: #2878d8;
    out property <color> launch-green: #148a3b;
    out property <color> launch-hover: #107e35;
    out property <color> launch-pressed: #09662c;
    out property <color> canvas: tone(#edf3f8, #131b25);
    out property <color> solid-panel: tone(#ffffff, #1e2834);
    out property <color> panel: tone(#ffffffde, #23303bef);
    out property <color> sidebar: tone(#f6f8fb, #18212d);
    out property <color> text: tone(#18232d, #edf2f6);
    out property <color> muted: tone(#67717b, #aeb9c7);
    out property <color> line: tone(#dce5ed, #364352);
    out property <color> hover: tone(#e9eef4, #344150);
    out property <color> accent: tone(#344859, #c2d3e5);
    out property <color> accent-fill: tone(#344859, #465e75);
    out property <color> accent-hover: tone(#40586b, #56718b);
    out property <color> accent-pressed: #273b4b;
    out property <color> accent-soft: tone(#e9eef4, #2c3a4a);
    out property <color> glass-rim: tone(#ffffffed, #e1efff3d);
    out property <color> hero-text: pixel-glass ? text : #ffffff;
    out property <color> hero-muted: pixel-glass ? muted : #c6d5f4;
    out property <color> hero-start: #1e2d59;
    out property <color> hero-end: #4b6094;
    out property <color> stage: tone(#edf2f7, #25334e);
    out property <color> sky: tone(#4a829e, #8dcbdc);
    out property <color> green: tone(#327b57, #82d6ad);
    out property <color> green-soft: tone(#eaf5ee, #213c31);
    out property <color> amber: tone(#926126, #e8bd7d);
    out property <color> amber-soft: tone(#fff4e3, #423524);
    out property <color> danger: tone(#bd4141, #ffa2a2);
}
