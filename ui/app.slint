import { LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ContextNavigation } from "context-navigation.slint";
import { WindowControls } from "window-controls.slint";
import { AppState } from "models.slint";
import { Label, Muted, Panel, AppButton, NativeButton, GlassPanel, Badge, Divider, EmptyState } from "components.slint";
import { GamesPage, ServersPage } from "pages/home-games.slint";
import { HomePage } from "pages/home.slint";
import { ResourcesPage, DownloadsPage, AccountsPage } from "pages/library.slint";
import { SettingsPage, DiagnosticsPage } from "pages/settings.slint";
import { OnboardingPage, PreparationPage, KnowledgePage } from "pages/guidance.slint";
import { Guidance } from "guidance-models.slint";
export { Guidance, CheckRow, GuideArticle, GuideStep } from "guidance-models.slint";
import { LauncherMark, ClubMark } from "branding.slint";
import { PixelGlass } from "pixel-glass.slint";
export { AppState, GameItem, ModItem, ResourceItem, DownloadItem, AccountItem, SearchItem, WallpaperItem, ExtensionItem } from "models.slint";
export { Theme } from "theme.slint";

export component AppWindow inherits Window {
    in property <bool> integrated-titlebar: false;
    no-frame: root.integrated-titlebar;
    resize-border-width: root.integrated-titlebar && !root.maximized ? 6px : 0px;
    title: "LXMCL";
    icon: @image-url("assets/launcher-logo.png");
    preferred-width: 1200px; preferred-height: 700px;
    min-width: 960px; min-height: 560px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: Theme.canvas;
    forward-focus: scope;
    property <int> modal-focus-index: 0;
    property <bool> wallpaper-visible: !root.minimized && AppState.page == 0;
    changed wallpaper-visible => { AppState.wallpaper-visibility(root.wallpaper-visible); }
    property <float> theme-progress: Theme.dark ? 1 : 0;
    animate theme-progress { duration: Theme.animations-ready && !Theme.reduce-motion ? 180ms : 0ms; easing: ease-in-out; }
    changed theme-progress => { Theme.darkness = root.theme-progress; }
    property <bool> account-open: false;
    property <bool> navigation-blocked: AppState.modal != "" || AppState.search-open;
    property <int> active-page: AppState.page;
    changed active-page => { root.account-open = false; }
    property <int> navigation-page: AppState.page == 7 || AppState.page == 8 ? Guidance.help-return-page : AppState.page;
    property <int> active-tab: root.navigation-page == 1 || root.navigation-page == 3 || root.navigation-page == 4 ? 1 : root.navigation-page == 2 ? 2 : root.navigation-page >= 5 && root.navigation-page <= 8 ? 3 : 0;
    // Compatibility hook used once after layout by the Rust shell. Sidebar
    // animation is no longer driven by the top navigation.
    public function sync-nav() { }
    function close-account() { root.account-open = false; account-button.focus-button(); }
    function step-modal-focus(back: bool) {
        let count = AppState.modal == "create" ? 5 : AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete" || AppState.modal == "rename" ? 3 : 2;
        root.modal-focus-index = mod(root.modal-focus-index + (back ? count - 1 : 1), count);
        if(AppState.modal == "create") {
            if(root.modal-focus-index == 0) { form-input.focus(); }
            if(root.modal-focus-index == 1) { version-input.focus(); }
            if(root.modal-focus-index == 2) { loader-input.focus(); }
            if(root.modal-focus-index == 3) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 4) { confirm-button.focus-button(); }
        } else if(count == 3) {
            if(root.modal-focus-index == 0) { form-input.focus(); }
            if(root.modal-focus-index == 1) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 2) { confirm-button.focus-button(); }
        } else {
            if(root.modal-focus-index == 0) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 1) { confirm-button.focus-button(); }
        }
    }
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    public function sync-theme() { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    public function focus-search() { AppState.search-open = true; AppState.search(""); search-input.focus(); }
    public function focus-main() { scope.focus(); }
    public function focus-search-input() { if(AppState.search-open) { search-input.focus(); } }
    public function focus-modal() {
        root.modal-focus-index = 0;
        if(AppState.modal == "create" || AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete" || AppState.modal == "rename") { form-input.focus(); }
        else { cancel-button.focus-button(); }
    }
    function global-key(e: KeyEvent) -> EventResult {
            if(e.modifiers.alt && e.text == Key.LeftArrow && AppState.modal == "" && !AppState.search-open) {
                if(AppState.page == 1 && AppState.instance-detail-open) { AppState.back-to-instances(); return accept; }
                if(AppState.page == 7 || AppState.page == 8) { AppState.page = Guidance.help-return-page; return accept; }
            }
            if(e.text == Key.F1 && AppState.modal == "" && !AppState.search-open) { Guidance.context-help(); return accept; }
            if(e.text == Key.Tab && AppState.modal != "") { root.step-modal-focus(e.modifiers.shift); return accept; }
            if(e.text == Key.Tab && AppState.search-open) { search-input.focus(); return accept; }
            if(e.modifiers.control && (e.text == "k" || e.text == "K")) { if(AppState.modal == "") { root.focus-search(); } return accept; }
            if(e.text == Key.Escape) {
                if(AppState.search-open) { AppState.search-open = false; scope.focus(); return accept; }
                if(AppState.modal != "") { AppState.close-modal(); scope.focus(); return accept; }
            }
            reject
    }
    scope := FocusScope {
        capture-key-pressed(e) => { root.global-key(e) }
        key-pressed(e) => { root.global-key(e) }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 60px; background: Theme.window-surface;
                HorizontalLayout {
                    padding-left: 24px; padding-right: root.integrated-titlebar ? 6px : 22px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                    WindowMoveArea {
                        enabled: root.integrated-titlebar;
                        width: root.integrated-titlebar ? 140px : 176px;
                        TouchArea { enabled: root.integrated-titlebar; double-clicked => { root.maximized = !root.maximized; } }
                        HorizontalLayout {
                        spacing: 10px;
                        Image { source: @image-url("assets/launcher-logo.png"); width: 32px; height: 32px; image-fit: contain; }
                        Label { text: "LXMCL"; font-size: 20px; font-weight: 700; }
                        }
                    }
                    WindowMoveArea { enabled: root.integrated-titlebar; horizontal-stretch: 1; TouchArea { enabled: root.integrated-titlebar; double-clicked => { root.maximized = !root.maximized; } } }
                    Rectangle {
                        width: 424px;
                        Rectangle {
                            x: root.active-tab * 108px; width: 100px; height: parent.height; border-radius: 12px; background: Theme.surface-control;
                            animate x { duration: Theme.animations-ready && !Theme.reduce-motion ? 190ms : 0ms; easing: cubic-bezier(0.22, 0.8, 0.24, 1); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            NativeButton { enabled: !root.navigation-blocked; width: 100px; text: "主页"; with-icon: true; icon: @image-url("icons/home.svg"); quiet: true; clicked => { AppState.navigate(0); } }
                            NativeButton { enabled: !root.navigation-blocked; width: 100px; text: "版本"; with-icon: true; icon: @image-url("icons/cube.svg"); quiet: true; clicked => { AppState.instance-detail-open = false; AppState.navigate(1); } }
                            NativeButton { enabled: !root.navigation-blocked; width: 100px; text: "联机"; with-icon: true; icon: @image-url("icons/server.svg"); quiet: true; clicked => { AppState.navigate(2); } }
                            NativeButton { enabled: !root.navigation-blocked; width: 100px; text: "设置"; with-icon: true; icon: @image-url("icons/settings.svg"); quiet: true; clicked => { AppState.navigate(6); } }
                        }
                    }
                    WindowMoveArea { enabled: root.integrated-titlebar; horizontal-stretch: 1; TouchArea { enabled: root.integrated-titlebar; double-clicked => { root.maximized = !root.maximized; } } }
                    Rectangle {
                        width: root.integrated-titlebar ? 134px : 176px;
                        account-button := NativeButton {
                            enabled: !root.navigation-blocked;
                            text: root.integrated-titlebar && root.width < 1100px ? "" : "       " + AppState.account-name; trailing-arrow: true; quiet: true; selected: root.account-open;
                            description: "账号菜单，" + AppState.account-name;
                            clicked => { root.account-open = !root.account-open; if(root.account-open) { account-focus.focus(); } }
                        }
                        Image { source: @image-url("assets/luanxiao.png"); source-clip-x: 8; source-clip-y: 8; source-clip-width: 8; source-clip-height: 8; x: 10px; y: 5px; width: 30px; height: 30px; image-rendering: pixelated; }
                    }
                    if(root.integrated-titlebar): Rectangle { width: 138px; }
                }
            }
            if(AppState.page >= 1 && AppState.page <= 8): ContextNavigation { search => { root.focus-search(); } }
            if(Guidance.guide-started && (AppState.page == 1 || AppState.page == 5 || AppState.page == 6)): Panel {
                height: 52px;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                    Muted { text: "游玩向导已保留在第 " + (Guidance.step + 1) + " 步。"; }
                    AppButton { text: "继续向导"; clicked => { Guidance.open-guide(); } }
                }
            }
            Rectangle {
                if(AppState.page == 0): HomePage { window-visible: !root.minimized; }
                if(AppState.page == 1): GamesPage {}
                if(AppState.page == 2): ServersPage {}
                if(AppState.page == 3): ResourcesPage {}
                if(AppState.page == 4): DownloadsPage {}
                if(AppState.page == 5): AccountsPage {}
                if(AppState.page == 6): SettingsPage {}
                if(AppState.page == 7): DiagnosticsPage {}
                if(AppState.page == 8): KnowledgePage {}
                if(AppState.page == 9): OnboardingPage {}
                if(AppState.page == 10): PreparationPage {}
            }
        }
        Rectangle {
            opacity: root.account-open && AppState.modal == "" && !AppState.search-open ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.animations-ready && !Theme.reduce-motion ? 160ms : 0ms; }
            TouchArea { enabled: root.account-open; clicked => { root.close-account(); } }
            GlassPanel {
                x: parent.width - self.width - (root.integrated-titlebar ? 156px : 22px); y: 66px; width: 286px; height: min(parent.height - 90px, AppState.accounts.length * 66px + 76px); border-radius: 18px;
                TouchArea {}
                account-focus := FocusScope {
                    enabled: root.account-open;
                    key-pressed(e) => { if(e.text == Key.Escape) { root.close-account(); return accept; } reject }
                    VerticalLayout {
                        padding: 10px; spacing: 6px;
                        ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                spacing: 4px;
                                for account in AppState.accounts: Rectangle {
                                    height: 62px;
                                    NativeButton { quiet: true; enabled: root.account-open; selected: account.active; description: "切换账号 " + account.name + "，" + account.kind; clicked => { AppState.select-account(account.id); root.close-account(); } }
                                    VerticalLayout {
                                        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 4px;
                                        Label { text: account.name + (account.active ? "   ✓" : ""); font-weight: 600; }
                                        Muted { text: account.kind; }
                                    }
                                }
                            }
                        }
                        Divider {}
                        NativeButton { height: 38px; enabled: root.account-open; text: "管理账号与装扮"; quiet: true; clicked => { root.account-open = false; AppState.navigate(5); } }
                    }
                }
            }
        }
        if(AppState.toast != "" && AppState.modal == "" && !AppState.search-open): Panel {
            opaque: true;
            x: max(210px, parent.width - 490px); y: parent.height - 92px; width: 460px; height: 54px; border-color: Theme.accent;
            HorizontalLayout { padding: 14px; spacing: 8px; Label { text: AppState.toast; font-size: 12px; wrap: word-wrap; } AppButton { text: "×"; quiet: true; preferred-width: 28px; clicked => { AppState.toast = ""; } } }
        }
        Rectangle {
            visible: AppState.modal != "";
            y: 60px; height: parent.height - 60px;
            background: #10182788; TouchArea {}
            Panel {
                opaque: true;
                width: AppState.modal == "rename" ? 440px : 520px;
                height: min(parent.height - 32px, (AppState.modal == "rename" ? 260px : AppState.modal == "create" ? 400px : AppState.modal == "install" ? 360px : 300px) + (AppState.form-error != "" ? 60px : 0px));
                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                TouchArea {}
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout { Label { text: AppState.modal-title; font-size: 17px; font-weight: 600; } AppButton { text: "×"; quiet: true; preferred-width: 32px; enabled: !AppState.instance-saving || AppState.modal == "rename"; clicked => { AppState.close-modal(); scope.focus(); } } }
                    Label { text: AppState.modal-body; wrap: word-wrap; font-size: 13px; color: Theme.muted; }
                    form-input := LineEdit {
                        visible: AppState.modal == "create" || AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete" || AppState.modal == "rename";
                        height: self.visible ? 32px : 0px;
                        enabled: !AppState.instance-saving;
                        text <=> AppState.form-name;
                        placeholder-text: AppState.modal == "delete" ? "输入完整实例名称，确认删除对象" : AppState.modal == "create" ? "实例名称" : AppState.modal == "rename" ? "新的实例名称" : AppState.modal == "account" ? "角色名称" : "资源名称（演示条目）";
                        accepted(_) => { if(AppState.modal != "delete" && !AppState.instance-saving) { AppState.confirm-modal(); } }
                    }
                    Rectangle {
                        visible: AppState.modal == "create";
                        height: self.visible ? 116px : 0px;
                        VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout { Label { text: "游戏版本"; } version-input := ComboBox { model: ["1.21.1", "1.20.1"]; current-index <=> AppState.form-version; min-width: 200px; } }
                        HorizontalLayout { Label { text: "模组加载器"; } loader-input := ComboBox { model: ["Fabric", "原版", "Forge"]; current-index <=> AppState.form-loader; min-width: 200px; } }
                        Muted { text: "保存目录：" + AppState.folder; wrap: word-wrap; }
                        }
                    }
                    if(AppState.modal == "account"): Muted { text: "仅创建本地预览身份，不收集密码、不发起真实认证。"; wrap: word-wrap; }
                    if(AppState.form-error != ""): Label { text: AppState.form-error; color: Theme.danger; wrap: word-wrap; font-size: 12px; }
                    Rectangle { vertical-stretch: 1; } Divider {}
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        cancel-button := AppButton { text: AppState.modal == "rename" && AppState.instance-saving ? "关闭" : "取消"; enabled: !AppState.instance-saving || AppState.modal == "rename"; clicked => { AppState.close-modal(); scope.focus(); } }
                        confirm-button := AppButton {
                            text: AppState.modal == "create" ? "创建实例" : AppState.modal == "rename" ? "保存名称" : AppState.modal == "delete" ? "删除实例" : AppState.modal == "install" ? "确认安装" : AppState.modal == "join" ? "模拟下载并进入" : AppState.modal == "import" ? "添加导入条目" : AppState.modal == "account" ? "添加本地账号" : "知道了";
                            primary: AppState.modal != "delete"; danger: AppState.modal == "delete"; enabled: !AppState.instance-saving; clicked => { AppState.confirm-modal(); }
                        }
                    }
                }
            }
        }
        Rectangle {
            visible: AppState.search-open; background: #10182788;
            y: 60px; height: parent.height - 60px;
            TouchArea { clicked => { AppState.search-open = false; scope.focus(); } }
            Panel {
                opaque: true;
                width: 650px; height: min(500px, parent.height - 60px); x: (parent.width - self.width)/2; y: 10px;
                TouchArea {}
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        search-input := LineEdit {
                            text: AppState.search-query; placeholder-text: "搜索游戏、服务器、资源或设置";
                            edited(t) => { AppState.search(t); }
                            accepted(_) => { if(AppState.search-results.length > 0) { AppState.activate-search(AppState.search-results[AppState.search-index].id); scope.focus(); } }
                            key-pressed(e) => {
                                if(e.text == Key.DownArrow) { AppState.search-index = min(AppState.search-results.length - 1, AppState.search-index + 1); return accept; }
                                if(e.text == Key.UpArrow) { AppState.search-index = max(0, AppState.search-index - 1); return accept; }
                                reject
                            }
                        }
                        AppButton { text: "Esc"; quiet: true; preferred-width: 44px; clicked => { AppState.search-open = false; scope.focus(); } }
                    }
                    Divider {}
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 6px;
                            for result[i] in AppState.search-results: Rectangle {
                                height: 66px; border-radius: Theme.pixel-glass ? 0px : 6px;
                                background: i == AppState.search-index ? (Theme.tone(#e3edff, #30456b)) : transparent;
                                HorizontalLayout {
                                    padding: 12px; spacing: 15px; Badge { text: result.category; }
                                    VerticalLayout { spacing: 5px; Label { text: result.name; font-weight: 600; } Muted { text: result.detail; } }
                                    AppButton { text: "打开"; quiet: true; clicked => { AppState.activate-search(result.id); scope.focus(); } }
                                }
                            }
                            if(AppState.search-results.length == 0): EmptyState { title: "没有找到匹配项"; description: "可以搜索「社团」「Java」「模组」或游戏名称。"; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Muted { text: "↑ ↓ 选择    Enter 打开    Esc 关闭"; }
                }
            }
        }
        // Keep native window actions above scrims and inside global key handling.
        if(root.integrated-titlebar): Rectangle {
            x: root.width - 144px; y: 10px; width: 138px; height: 40px;
            background: Theme.window-surface;
            WindowControls {
                maximized: root.maximized;
                minimize => { root.minimized = true; }
                toggle-maximize => { root.maximized = !root.maximized; }
                close => { root.close(); }
            }
        }
    }
}
