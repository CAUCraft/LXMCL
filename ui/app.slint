import { LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "models.slint";
import { Label, Muted, Panel, AppButton, NavItem, Badge, Divider, EmptyState } from "components.slint";
import { GamesPage, ServersPage } from "pages/home-games.slint";
import { HomePage } from "pages/home.slint";
import { ResourcesPage, DownloadsPage, AccountsPage } from "pages/library.slint";
import { SettingsPage, DiagnosticsPage } from "pages/settings.slint";
import { OnboardingPage, PreparationPage, KnowledgePage } from "pages/guidance.slint";
import { Guidance } from "guidance-models.slint";
export { Guidance, CheckRow, GuideArticle, GuideStep } from "guidance-models.slint";
import { LauncherMark, ClubMark } from "branding.slint";
import { PixelGlass } from "pixel-glass.slint";
export { AppState, GameItem, ModItem, ResourceItem, DownloadItem, AccountItem, SearchItem, WallpaperItem } from "models.slint";
export { Theme } from "theme.slint";

export component AppWindow inherits Window {
    title: "LXMCL · 前端预览";
    icon: @image-url("assets/launcher-logo.png");
    preferred-width: 1180px; preferred-height: 700px;
    min-width: 1040px; min-height: 640px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: Theme.canvas;
    forward-focus: scope;
    property <int> modal-focus-index: 0;
    property <bool> wallpaper-visible: !root.minimized;
    changed wallpaper-visible => { AppState.wallpaper-visibility(root.wallpaper-visible); }
    property <float> theme-progress: Theme.dark ? 1 : 0;
    animate theme-progress { duration: Theme.animations-ready ? 360ms : 0ms; easing: ease-in-out; }
    changed theme-progress => { Theme.darkness = root.theme-progress; }
    property <bool> home-interactive: AppState.page == 0 && AppState.modal == "" && !AppState.search-open && !root.minimized;
    changed home-interactive => { if(!root.home-interactive) { AppState.track-mascot(0, 0, false); } }
    property <length> nav-position: AppState.page == 0 || AppState.page >= 9 ? nav0.y : AppState.page == 1 ? nav1.y : AppState.page == 2 ? nav2.y : AppState.page == 3 ? nav3.y : AppState.page == 4 ? nav4.y : AppState.page == 5 ? nav5.y : AppState.page == 6 ? nav6.y : AppState.page == 7 ? nav7.y : nav8.y;
    changed nav-position => { AppState.move-nav(root.nav-position / 1px); }
    property <float> nav-dark: Theme.darkness;
    property <bool> nav-glass: Theme.pixel-glass;
    changed nav-dark => { AppState.refresh-nav(); }
    changed nav-glass => { root.sync-nav(); }
    public function sync-nav() { AppState.move-nav(root.nav-position / 1px); AppState.refresh-nav(); }
    function step-modal-focus(back: bool) {
        let count = AppState.modal == "create" ? 5 : AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete" ? 3 : 2;
        root.modal-focus-index = mod(root.modal-focus-index + (back ? count - 1 : 1), count);
        if(AppState.modal == "create") {
            if(root.modal-focus-index == 0) { form-input.focus(); }
            if(root.modal-focus-index == 1) { version-input.focus(); }
            if(root.modal-focus-index == 2) { loader-input.focus(); }
            if(root.modal-focus-index == 3) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 4) { confirm-button.focus-button(); }
        } else if(count == 3) {
            if(root.modal-focus-index == 0) { form-input.focus(); }
            if(root.modal-focus-index == 1) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 2) { confirm-button.focus-button(); }
        } else {
            if(root.modal-focus-index == 0) { cancel-button.focus-button(); }
            if(root.modal-focus-index == 1) { confirm-button.focus-button(); }
        }
    }
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    public function sync-theme() { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    public function focus-search() { AppState.search-open = true; AppState.search(""); search-input.focus(); }
    public function focus-main() { scope.focus(); }
    public function focus-search-input() { if(AppState.search-open) { search-input.focus(); } }
    public function focus-modal() {
        root.modal-focus-index = 0;
        if(AppState.modal == "create" || AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete") { form-input.focus(); }
        else { cancel-button.focus-button(); }
    }
    function global-key(e: KeyEvent) -> EventResult {
            if(e.text == Key.F1 && AppState.modal == "" && !AppState.search-open) { Guidance.context-help(); return accept; }
            if(e.text == Key.Tab && AppState.modal != "") { root.step-modal-focus(e.modifiers.shift); return accept; }
            if(e.text == Key.Tab && AppState.search-open) { search-input.focus(); return accept; }
            if(e.modifiers.control && (e.text == "k" || e.text == "K")) { if(AppState.modal == "") { root.focus-search(); } return accept; }
            if(e.text == Key.Escape) {
                if(AppState.search-open) { AppState.search-open = false; scope.focus(); return accept; }
                if(AppState.modal != "") { AppState.close-modal(); scope.focus(); return accept; }
            }
            reject
    }
    scope := FocusScope {
        capture-key-pressed(e) => { root.global-key(e) }
        key-pressed(e) => { root.global-key(e) }
        if(Theme.pixel-glass): Rectangle {
            Image { source: @image-url("assets/glass-wallpaper-light.svg"); width: parent.width; height: parent.height; image-fit: fill; }
            Image { source: @image-url("assets/glass-wallpaper-dark.svg"); opacity: Theme.darkness; width: parent.width; height: parent.height; image-fit: fill; }
        }
        if(AppState.wallpaper-enabled && AppState.wallpaper-ready): Rectangle {
            Image { source: AppState.wallpaper-frame; width: parent.width; height: parent.height; image-fit: cover; }
            Rectangle { background: Theme.tone(#edf3ff85, #080e2070); }
        }
        HorizontalLayout {
            padding: Theme.pixel-glass ? 12px : 0px;
            spacing: Theme.pixel-glass ? 12px : 0px;
            Rectangle {
                width: 196px; background: Theme.pixel-glass ? transparent : Theme.sidebar;
                if(Theme.pixel-glass): PixelGlass { tint: Theme.sidebar; step: 6px; }
                if(Theme.pixel-glass): Image {
                    x: 14px; y: AppState.nav-top * 1px; width: 168px; height: AppState.nav-height * 1px;
                    source: AppState.nav-image; image-rendering: pixelated; image-fit: fill;
                }
                VerticalLayout {
                    padding-left: 14px; padding-right: 14px; padding-top: 20px; padding-bottom: 16px; spacing: 6px;
                    HorizontalLayout {
                        padding-left: 8px; spacing: 10px;
                        LauncherMark { width: 44px; height: 44px; }
                        VerticalLayout { spacing: 2px; Label { text: "LXMCL"; font-size: 22px; font-weight: 700; } Muted { text: "CAUCRAFT LAUNCHER"; font-size: 8px; } }
                    }
                    Muted { text: "中国民航大学 Minecraft 社团"; height: 22px; horizontal-alignment: center; font-size: 10px; }
                    Rectangle { height: 12px; }
                    nav0 := NavItem { text: "开始游戏"; icon: Theme.pixel-glass ? @image-url("icons/pixel/home.svg") : @image-url("icons/home.svg"); selected: AppState.page == 0 || AppState.page >= 9; clicked => { AppState.navigate(0); } }
                    nav1 := NavItem { text: "我的游戏"; icon: Theme.pixel-glass ? @image-url("icons/pixel/games.svg") : @image-url("icons/games.svg"); selected: AppState.page == 1; clicked => { AppState.navigate(1); } }
                    nav2 := NavItem { text: "社团联机"; icon: Theme.pixel-glass ? @image-url("icons/pixel/server.svg") : @image-url("icons/server.svg"); selected: AppState.page == 2; clicked => { AppState.navigate(2); } }
                    nav3 := NavItem { text: "资源中心"; icon: Theme.pixel-glass ? @image-url("icons/pixel/resources.svg") : @image-url("icons/resources.svg"); selected: AppState.page == 3; clicked => { AppState.navigate(3); } }
                    Rectangle { height: 12px; } Divider {} Rectangle { height: 8px; }
                    nav4 := NavItem { text: "下载任务"; icon: Theme.pixel-glass ? @image-url("icons/pixel/download.svg") : @image-url("icons/download.svg"); count: AppState.active-downloads > 0 ? AppState.active-downloads : ""; selected: AppState.page == 4; clicked => { AppState.navigate(4); } }
                    nav5 := NavItem { text: "账号与装扮"; icon: Theme.pixel-glass ? @image-url("icons/pixel/account.svg") : @image-url("icons/account.svg"); selected: AppState.page == 5; clicked => { AppState.navigate(5); } }
                    Rectangle { vertical-stretch: 1; min-height: 16px; }
                    nav6 := NavItem { text: "设置"; icon: Theme.pixel-glass ? @image-url("icons/pixel/settings.svg") : @image-url("icons/settings.svg"); selected: AppState.page == 6; clicked => { AppState.navigate(6); } }
                    nav7 := NavItem { text: "诊断与工具"; icon: Theme.pixel-glass ? @image-url("icons/pixel/diagnostics.svg") : @image-url("icons/diagnostics.svg"); selected: AppState.page == 7; clicked => { AppState.navigate(7); } }
                    nav8 := NavItem { text: "帮助中心"; icon: Theme.pixel-glass ? @image-url("icons/pixel/help.svg") : @image-url("icons/help.svg"); selected: AppState.page == 8; clicked => { AppState.navigate(8); } }
                    Divider {}
                    AppButton { text: AppState.account-name + "  ·  切换"; quiet: true; clicked => { AppState.navigate(5); } }
                }
            }
            if(!Theme.pixel-glass): Rectangle { width: 1px; background: Theme.line; }
            VerticalLayout {
                spacing: Theme.pixel-glass ? 6px : 0px;
                Rectangle {
                    height: 64px; background: Theme.pixel-glass ? transparent : Theme.panel;
                    if(Theme.pixel-glass): PixelGlass { step: 4px; }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; spacing: 12px;
                        AppButton { text: "搜索游戏与功能    Ctrl K"; min-width: 252px; with-icon: Theme.pixel-glass; icon: @image-url("icons/pixel/search.svg"); clicked => { root.focus-search(); } }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: "壁纸"; preferred-width: 56px; clicked => { AppState.navigate(6); } }
                        HorizontalLayout {
                            spacing: 4px;
                            AppButton { text: "经典"; description: "使用经典主题"; preferred-width: 60px; primary: !Theme.pixel-glass; clicked => { AppState.set-pixel-glass(false); } }
                            AppButton { text: "像素玻璃"; description: "使用像素玻璃主题"; preferred-width: 92px; primary: Theme.pixel-glass; clicked => { AppState.set-pixel-glass(true); } }
                        }
                        AppButton { text: Theme.dark ? "浅色" : "深色"; description: "切换浅色与深色模式"; with-icon: true; icon: Theme.dark ? @image-url("icons/pixel/sun.svg") : @image-url("icons/pixel/moon.svg"); preferred-width: 78px; clicked => { AppState.set-dark(!Theme.dark); } }
                    }
                    if(!Theme.pixel-glass): Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                }
                if(Guidance.guide-started && (AppState.page == 1 || AppState.page == 5 || AppState.page == 6)): Panel {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                        Muted { text: "首次游玩向导已保留在第 " + (Guidance.step + 1) + " 步，完成这里的操作后可以继续。"; wrap: word-wrap; }
                        AppButton { text: "返回游玩向导"; clicked => { Guidance.open-guide(); } }
                    }
                }
                Rectangle {
                    if(AppState.page == 0): HomePage { window-visible: !root.minimized; }
                    if(AppState.page == 1): GamesPage {}
                    if(AppState.page == 2): ServersPage {}
                    if(AppState.page == 3): ResourcesPage {}
                    if(AppState.page == 4): DownloadsPage {}
                    if(AppState.page == 5): AccountsPage {}
                    if(AppState.page == 6): SettingsPage {}
                    if(AppState.page == 7): DiagnosticsPage {}
                    if(AppState.page == 8): KnowledgePage {}
                    if(AppState.page == 9): OnboardingPage {}
                    if(AppState.page == 10): PreparationPage {}
                }
                Rectangle {
                    height: 32px; background: Theme.pixel-glass ? transparent : Theme.panel;
                    HorizontalLayout { padding-left: 18px; padding-right: 18px; Muted { text: AppState.launching ? AppState.launch-status : "演示数据 · 尚未连接游戏与网络服务"; font-size: 11px; } Muted { text: Theme.pixel-glass ? "PIXEL / GLASS   ·   0.1.0" : "0.1.0"; font-size: 10px; horizontal-alignment: right; } }
                }
            }
        }
        if(AppState.toast != "" && AppState.modal == "" && !AppState.search-open): Panel {
            opaque: true;
            x: max(210px, parent.width - 490px); y: parent.height - 92px; width: 460px; height: 54px; border-color: Theme.accent;
            HorizontalLayout { padding: 14px; spacing: 8px; Label { text: AppState.toast; font-size: 12px; wrap: word-wrap; } AppButton { text: "×"; quiet: true; preferred-width: 28px; clicked => { AppState.toast = ""; } } }
        }
        Rectangle {
            visible: AppState.modal != "";
            background: #10182788; TouchArea {}
            Panel {
                opaque: true;
                width: 540px; height: AppState.modal == "create" ? 470px : AppState.modal == "install" ? 440px : AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete" ? 410px : 360px;
                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                TouchArea {}
                VerticalLayout {
                    padding: 26px; spacing: 16px;
                    HorizontalLayout { Label { text: AppState.modal-title; font-size: 21px; font-weight: 600; } AppButton { text: "×"; quiet: true; preferred-width: 32px; clicked => { AppState.close-modal(); scope.focus(); } } }
                    Label { text: AppState.modal-body; wrap: word-wrap; font-size: 13px; color: Theme.muted; }
                    form-input := LineEdit {
                        visible: AppState.modal == "create" || AppState.modal == "import" || AppState.modal == "account" || AppState.modal == "delete";
                        height: self.visible ? 32px : 0px;
                        text <=> AppState.form-name;
                        placeholder-text: AppState.modal == "delete" ? "输入完整游戏名称，确认删除对象" : AppState.modal == "create" ? "游戏名称" : AppState.modal == "account" ? "角色名称" : "资源名称（演示条目）";
                        accepted(_) => { if(AppState.modal != "delete") { AppState.confirm-modal(); } }
                    }
                    Rectangle {
                        visible: AppState.modal == "create";
                        height: self.visible ? 116px : 0px;
                        VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout { Label { text: "游戏版本"; } version-input := ComboBox { model: ["1.21.1", "1.20.1"]; current-index <=> AppState.form-version; min-width: 200px; } }
                        HorizontalLayout { Label { text: "模组加载器"; } loader-input := ComboBox { model: ["Fabric", "原版", "Forge"]; current-index <=> AppState.form-loader; min-width: 200px; } }
                        Muted { text: "保存目录：" + AppState.folder; wrap: word-wrap; }
                        }
                    }
                    if(AppState.modal == "account"): Muted { text: "仅创建本地预览身份，不收集密码、不发起真实认证。"; wrap: word-wrap; }
                    if(AppState.form-error != ""): Label { text: AppState.form-error; color: Theme.danger; wrap: word-wrap; font-size: 12px; }
                    Rectangle { vertical-stretch: 1; } Divider {}
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        cancel-button := AppButton { text: "取消"; clicked => { AppState.close-modal(); scope.focus(); } }
                        confirm-button := AppButton {
                            text: AppState.modal == "create" ? "创建游戏" : AppState.modal == "delete" ? "删除游戏" : AppState.modal == "install" ? "确认安装" : AppState.modal == "join" ? "模拟下载并进入" : AppState.modal == "import" ? "添加导入条目" : AppState.modal == "account" ? "添加本地账号" : "知道了";
                            primary: AppState.modal != "delete"; danger: AppState.modal == "delete"; clicked => { AppState.confirm-modal(); }
                        }
                    }
                }
            }
        }
        Rectangle {
            visible: AppState.search-open; background: #10182788;
            TouchArea { clicked => { AppState.search-open = false; scope.focus(); } }
            Panel {
                opaque: true;
                width: 650px; height: min(500px, parent.height - 120px); x: (parent.width - self.width)/2; y: 70px;
                TouchArea {}
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        search-input := LineEdit {
                            text: AppState.search-query; placeholder-text: "搜索游戏、服务器、资源或设置";
                            edited(t) => { AppState.search(t); }
                            accepted(_) => { if(AppState.search-results.length > 0) { AppState.activate-search(AppState.search-results[AppState.search-index].id); scope.focus(); } }
                            key-pressed(e) => {
                                if(e.text == Key.DownArrow) { AppState.search-index = min(AppState.search-results.length - 1, AppState.search-index + 1); return accept; }
                                if(e.text == Key.UpArrow) { AppState.search-index = max(0, AppState.search-index - 1); return accept; }
                                reject
                            }
                        }
                        AppButton { text: "Esc"; quiet: true; preferred-width: 44px; clicked => { AppState.search-open = false; scope.focus(); } }
                    }
                    Divider {}
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 6px;
                            for result[i] in AppState.search-results: Rectangle {
                                height: 66px; border-radius: Theme.pixel-glass ? 0px : 6px;
                                background: i == AppState.search-index ? (Theme.tone(#e3edff, #30456b)) : transparent;
                                HorizontalLayout {
                                    padding: 12px; spacing: 15px; Badge { text: result.category; }
                                    VerticalLayout { spacing: 5px; Label { text: result.name; font-weight: 600; } Muted { text: result.detail; } }
                                    AppButton { text: "打开"; quiet: true; clicked => { AppState.activate-search(result.id); scope.focus(); } }
                                }
                            }
                            if(AppState.search-results.length == 0): EmptyState { title: "没有找到匹配项"; description: "可以搜索「社团」「Java」「模组」或游戏名称。"; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Muted { text: "↑ ↓ 选择    Enter 打开    Esc 关闭"; }
                }
            }
        }
    }
}
