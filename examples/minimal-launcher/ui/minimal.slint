// 最小示例界面：产品名、游戏目录编辑框、保存按钮、状态行。
// 这个窗口不知道设置存在哪里、由哪个插件提供——保存回调只调用 SettingsBridge。
import { LineEdit, Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MinimalWindow inherits Window {
    title: product-name;
    min-width: 460px;
    min-height: 170px;
    background: #14161b;

    in property <string> product-name;
    in-out property <string> game-root;
    in property <string> status;
    callback save();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: product-name;
            font-size: 20px;
            font-weight: 700;
            color: #f2f3f5;
        }

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "游戏目录：";
                vertical-alignment: center;
                color: #b9bec8;
            }
            LineEdit {
                text <=> root.game-root;
                min-width: 280px;
            }
        }

        Button {
            text: "保存设置";
            clicked => root.save();
        }

        Text {
            text: status;
            color: #8fd3a7;
        }
    }
}
